# Copy to .env and adjust for your machine.
# Restart Expo after changing this file.

# Backend API URL (host + port only — /api is appended automatically)
# - Physical device: your computer's LAN IP (same Wi-Fi as the phone)
# - Android emulator: http://10.0.2.2:5000
# - iOS simulator: http://localhost:5000
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:5000

# Expo dev server (Metro) runs on port 8080 via npm start — see package.json scripts.
