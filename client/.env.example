# Copy to .env and adjust for your environment:
#   cp .env.example .env
#
# Expo exposes variables prefixed with EXPO_PUBLIC_ to the app at build time.
# Restart `npx expo start` after changing this file.

# API base URL (no trailing slash)
# - Physical device on same Wi-Fi: use your computer's LAN IP
# - Android emulator: http://10.0.2.2:8080/api
# - iOS simulator: http://localhost:8080/api
# - Leave unset to auto-detect from Expo dev server host
EXPO_PUBLIC_API_URL=http://192.168.1.100:8080/api
