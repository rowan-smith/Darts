# Copy to .env and adjust for your machine.
# Restart Expo after changing this file.

# Backend API URL (host + port only — /api is appended automatically)
# - Physical device: your computer's LAN IP (same Wi-Fi as the phone)
# - Android emulator: http://10.0.2.2:8080
# - iOS simulator: http://localhost:8080
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# On a physical device, replace localhost with your computer's LAN IP.
