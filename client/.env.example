# Copy to .env and set your machine's LAN IP:
#   cp .env.example .env
#
# Expo exposes EXPO_PUBLIC_* variables at build time.
# Restart `npx expo start` after changing this file.

# Backend URL (host + port only — /api is appended automatically)
# - Physical device on same Wi-Fi: your computer's LAN IP
# - Android emulator: http://10.0.2.2:8080
# - iOS simulator: http://localhost:8080
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8080
